# Skopiuj do .env i dostosuj.
NODE_ENV=development
PORT=3000
# Lokalnie bez Dockera: wbudowany Postgres (PGlite) w katalogu .data
DATABASE_URL=pglite:./.data/pglite
# Z docker-compose: postgres://detektyw:detektyw@localhost:5432/detektyw
APP_URL=http://localhost:5173
# Bez SMTP_URL e-maile (reset hasła) są wypisywane w logu serwera.
# SMTP_URL=smtp://localhost:1025
MAIL_FROM="Detektyw <no-reply@localhost>"
SESSION_DAYS=30
TRUST_PROXY=false
