# Skopiuj do .env i dostosuj.

# ---------- uruchomienie lokalne (npm run dev) ----------
NODE_ENV=development
PORT=3000
# Wbudowany Postgres (PGlite) w katalogu .data – nic nie trzeba instalować.
# DATABASE_URL=pglite:./.data/pglite
# Albo własny Postgres: postgres://uzytkownik:haslo@localhost:5432/detektyw
APP_URL=http://localhost:5173
# Bez SMTP_URL e-maile (reset hasła) są wypisywane w logu serwera.
# SMTP_URL=smtp://user:pass@smtp.twojadomena.pl:587
MAIL_FROM="Detektyw <no-reply@localhost>"
SESSION_DAYS=30

# ---------- Docker / VPS (docker compose) ----------
# APP_URL=https://detektyw.twojadomena.pl
# DOMAIN=detektyw.twojadomena.pl
# POSTGRES_PASSWORD=zmien-mnie-na-dlugie-haslo
# TRUST_PROXY=true

# ---------- opcjonalny asystent LLM (domyślnie wyłączony) ----------
# ASSISTANT_LLM=on
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_LLM_MODEL=claude-opus-5-5
# ASSISTANT_LLM_MAX_PER_HOUR=30
